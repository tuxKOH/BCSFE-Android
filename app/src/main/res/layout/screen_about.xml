<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="22dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/primary"
            xmlns:app="http://schemas.android.com/apk/res-auto">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/about_title"
                    android:textColor="@android:color/white" android:textSize="28sp" android:textStyle="bold" />
                <TextView android:id="@+id/version" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textColor="#DDF2EA" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:text="@string/attribution" android:textColor="@color/ink" android:textSize="16sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:background="@drawable/panel" android:padding="16dp" android:text="@string/supported_versions_notice" android:textColor="@color/muted" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="@string/official_links" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <com.google.android.material.button.MaterialButton android:id="@+id/officialWebsite" style="@style/Widget.BCSFE.OutlinedButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/official_website" />
                <com.google.android.material.button.MaterialButton android:id="@+id/qqGroup" style="@style/Widget.BCSFE.OutlinedButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/qq_group" />
            </LinearLayout>
            <Space android:layout_width="8dp" android:layout_height="1dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <com.google.android.material.button.MaterialButton android:id="@+id/discordServer" style="@style/Widget.BCSFE.OutlinedButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/discord_server" />
                <com.google.android.material.button.MaterialButton android:id="@+id/androidRepo" style="@style/Widget.BCSFE.OutlinedButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/android_repository" />
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/pythonRepo" style="@style/Widget.BCSFE.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/reference_repository" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="@string/language" android:textColor="@color/ink" android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton android:id="@+id/languageButton" style="@style/Widget.BCSFE.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/change_language" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:background="@drawable/panel" android:padding="16dp" android:text="@string/license_notice" android:textColor="@color/muted" />
    </LinearLayout>
</ScrollView>
