<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/paper">

    <!-- Main workspace. The session drawer is layered above it so the editor
         keeps its full width on phones and tablets. -->
    <LinearLayout android:id="@+id/mainWorkspace" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="72dp"
            android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp"
            android:background="@color/surface">
            <ImageButton android:id="@+id/sessionToggle" android:layout_width="52dp" android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/sessions"
                android:src="@android:drawable/ic_menu_sort_by_size" android:tint="@color/primary" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:paddingStart="8dp">
                <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/app_name" android:textColor="@color/ink" android:textSize="21sp" android:textStyle="bold" />
                <View android:layout_width="34dp" android:layout_height="3dp" android:layout_marginTop="5dp" android:background="@color/accent" />
            </LinearLayout>
            <ImageButton android:id="@+id/aboutButton" android:layout_width="52dp" android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/about"
                android:src="@android:drawable/ic_menu_info_details" android:tint="@color/primary" />
        </LinearLayout>
        <FrameLayout android:id="@+id/content" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>

    <!-- Tapping the dimmed workspace closes the drawer without requiring the
         toolbar button to remain reachable underneath it. -->
    <View android:id="@+id/sessionScrim" android:layout_width="match_parent" android:layout_height="match_parent"
        android:visibility="gone" android:background="#520E1E20" android:clickable="true" android:focusable="true" />

    <!-- Persistent session surface. It remains the same functional drawer,
         but is now a distinct navigation layer rather than a second column. -->
    <com.google.android.material.card.MaterialCardView android:id="@+id/sessionPanel"
        android:layout_width="304dp" android:layout_height="match_parent" android:visibility="gone"
        android:layout_gravity="start" android:layout_marginStart="12dp" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"
        app:cardCornerRadius="22dp" app:cardElevation="8dp" app:cardBackgroundColor="@color/surface_tint"
        xmlns:app="http://schemas.android.com/apk/res-auto">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/sessions" android:textColor="@color/ink" android:textSize="21sp" android:textStyle="bold" />
                <ImageButton android:id="@+id/sessionCloseButton" android:layout_width="44dp" android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/close"
                    android:src="@android:drawable/ic_menu_close_clear_cancel" android:tint="@color/primary" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:text="@string/session_long_press_hint" android:textColor="@color/muted" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/sessionImportButton"
                style="@style/Widget.BCSFE.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="14dp" android:text="@string/import_new_session" />
            <ListView android:id="@+id/sessionList" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:layout_marginTop="14dp" android:divider="@color/divider" android:dividerHeight="1dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
