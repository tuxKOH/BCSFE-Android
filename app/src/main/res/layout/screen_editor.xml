<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/fileInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/panel" android:padding="14dp" android:textColor="@color/ink" />
    <EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_marginTop="12dp" android:hint="@string/search_features" android:inputType="text" android:singleLine="true" />
    <ListView android:id="@+id/featureList" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:divider="@color/divider" android:dividerHeight="1dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/historyButton"
        style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent"
        android:layout_height="48dp" android:text="@string/history_title" />
    <com.google.android.material.button.MaterialButton android:id="@+id/exportButton"
        android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/export_save" />
    <com.google.android.material.button.MaterialButton android:id="@+id/uploadButton"
        style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/upload_transfer" />
    <com.google.android.material.button.MaterialButton android:id="@+id/rootWriteButton"
        style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/root_write_save" android:enabled="false" />
    <com.google.android.material.button.MaterialButton android:id="@+id/exitButton"
        style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/exit_editor" />
</LinearLayout>
