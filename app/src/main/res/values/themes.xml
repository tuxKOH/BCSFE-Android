<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BCSFE" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="materialButtonStyle">@style/Widget.BCSFE.Button</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.BCSFE.AlertDialog</item>
    </style>
    <style name="ThemeOverlay.BCSFE.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowMinWidthMajor">92%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:windowAnimationStyle">@style/Animation.BCSFE.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.BCSFE.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.BCSFE.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.BCSFE.DialogButton</item>
    </style>
    <style name="Animation.BCSFE.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>
    <style name="Widget.BCSFE.DialogButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Widget.BCSFE.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:insetTop">3dp</item>
        <item name="android:insetBottom">3dp</item>
        <item name="android:stateListAnimator">@animator/button_press</item>
    </style>
    <style name="Widget.BCSFE.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">3dp</item>
        <item name="android:insetBottom">3dp</item>
        <item name="android:stateListAnimator">@animator/button_press</item>
    </style>
</resources>
